# EP Dev Stack — default environment variables
# Copy to .env and customize as needed, or use as-is for defaults.

# Home Assistant
HA_PORT=18123
HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.2

# MQTT Broker
MQTT_PORT=1883

# Configurator
CONFIGURATOR_PORT=42069

# Dev user credentials (used by bootstrap script)
HA_DEV_USERNAME=dev
HA_DEV_PASSWORD=devpassword
HA_DEV_NAME=Developer
